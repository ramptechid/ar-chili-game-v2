# URL root server PHP kamu (tanpa trailing slash).
# Untuk production (VPS), isi dengan URL lengkap:
#   VITE_API_BASE=https://api.namadomain.com
# Untuk development lokal dengan XAMPP:
#   VITE_API_BASE=http://localhost/ar-chili-game-spawn/backend
#
# Salin file ini menjadi .env.production.local sebelum menjalankan npm run deploy.
VITE_API_BASE=https://api.namadomain.com
